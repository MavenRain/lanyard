mu Bytes : Type 0 :=
| bytesNil : Bytes
| bytesCons (head : Nat) (tail : Bytes) : Bytes

def main : Cx -> Uri -> Bytes -> Response :=
  fun (cx : Cx) (uri : Uri) (body : Bytes) =>
  Response.text Bytes (Text.replace Bytes
    (Form.field Bytes body b"text")
    (Form.field Bytes body b"needle")
    (Form.field Bytes body b"replacement"))
