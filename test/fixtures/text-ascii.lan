mu Bytes : Type 0 :=
| bytesNil : Bytes
| bytesCons (head : Nat) (tail : Bytes) : Bytes

def main : Cx -> Uri -> Bytes -> Response :=
  fun (cx : Cx) (uri : Uri) (body : Bytes) =>
  Response.text Bytes (Text.concat Bytes
    (Text.to_ascii_lowercase Bytes (Form.field Bytes body b"lower"))
    (Text.to_ascii_uppercase Bytes (Form.field Bytes body b"upper")))
