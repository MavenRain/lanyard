def Bool : Type 0 := sum ((prod () : Type 0), (prod () : Type 0))
def add : Nat -> Nat -> Nat := fun (x : Nat) (y : Nat) => natAdd x y
def subtract : Nat -> Nat -> Nat := fun (x : Nat) (y : Nat) => natSub x y
