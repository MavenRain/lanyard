def projection : Nat := pair.1
def choose : Bool -> Nat := fun (b : Bool) => case b with
| 0 (u : prod ()) => 11
| 1 (u : prod ()) => 29
def branch : Nat := choose (less 8 13)
def both : Nat := let x : Nat := 19 in add x x
def unit : prod () := tuple ()
